# =====================================================================
# 基于 RAG 的网络安全知识智能问答系统 - 环境变量示例
# 复制为 .env 后按需修改; 严禁将真实 API Key 提交到代码仓库
# =====================================================================

# ---------------- MySQL ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cyber_rag
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ---------------- Spring Boot ----------------
SERVER_PORT=8080
# JWT 密钥: 至少 32 字符随机字符串, 生产环境必须更换
JWT_SECRET=cyber-rag-jwt-secret-please-change-to-random-32chars
JWT_EXPIRE_HOURS=24

# ---------------- Python RAG 服务 ----------------
RAG_SERVICE_PORT=8000
# RAG 服务内部通信令牌(Java 后端与 Python 服务之间), 两端需一致
RAG_INTERNAL_TOKEN=cyber-rag-internal-token-change-me

# ---------------- LLM (OpenAI Compatible) ----------------
# 支持 GLM / Qwen / DeepSeek / OpenAI 等兼容接口
# LLM_PROVIDER: openai(默认, /chat/completions) | anthropic(Anthropic 兼容 /v1/messages)
# 智谱 BigModel 示例(Anthropic 兼容通道):
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   LLM_MODEL=glm-5.3-flash
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini
# 输出预算(含 GLM 5.x thinking): 过小会被推理耗尽导致正文为空, 建议 >=8192
LLM_MAX_TOKENS=8192

# ---------------- Embedding ----------------
# local: 本地 sentence-transformers 模型(默认); openai: OpenAI 兼容 Embedding API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# 轻量替代方案(显存/内存不足时, 论文实验即用此模型, 512 维): BAAI/bge-small-zh-v1.5
# openai 模式下的配置(EMBEDDING_DIMENSION 需与所选模型一致, 如 text-embedding-3-small=1536)
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_DIMENSION=1024

# ---------------- Reranker (可选) ----------------
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------------- 检索策略 (rag-service 默认, 可被 rag_config/请求参数覆盖) ----------------
# vector = 纯向量 | hybrid = 向量+BM25 RRF 融合
RAG_RETRIEVAL_STRATEGY=vector

# ---------------- Security-Aware Adaptive RAG (第四轮) ----------------
# 自适应总开关: 查询分析 + 四路径路由 + 置信度门控重排 + 动态上下文
# (前端"RAG 参数配置"页的 Adaptive 开关写入 rag_config, 可覆盖此默认值)
ADAPTIVE_ENABLED=false
# 安全实体精确加权(EXACT 路由下命中 CVE/CWE 等编号的 RRF 确定性加分)
ENTITY_BOOST_ENABLED=true
# 置信度门控重排阈值(检索信号足够好时跳过 CrossEncoder, 降低延迟)
RERANK_CONFIDENCE_THRESHOLD=0.75
RERANK_SCORE_MARGIN_THRESHOLD=0.08
RERANK_AGREEMENT_THRESHOLD=0.6
# 多跳分解阈值: 查询复杂度(0-10)达到此值且为 MULTI_HOP 才启用 LLM 分解
COMPLEXITY_THRESHOLD=7.5
# FAST 路由(简单事实题向量 Top-3 直出)判定阈值
FAST_PATH_TOP1_MIN=0.55
FAST_PATH_MARGIN_MIN=0.015
# 动态上下文预算(简单问题 2-3 块, 复杂问题最多 6 块 / max_context_tokens)
MAX_CONTEXT_TOKENS=3000
MIN_CONTEXT_CHUNKS=2
MAX_CONTEXT_CHUNKS=6
# Small-to-Large 分块(入库 chunk_mode=parent_child 时生效): 检索用小块, 生成用大块
PARENT_CHUNK_SIZE=1024
CHILD_CHUNK_SIZE=320
CHILD_CHUNK_OVERLAP=60
# Embedding / 检索缓存容量(LRU 条目数; 检索缓存 key 含知识库版本, 变更自动失效)
EMBEDDING_CACHE_SIZE=512
RETRIEVAL_CACHE_SIZE=256
# 启动预热(embedding + reranker 首推理后台执行, 消除首问冷启动)
WARMUP_ENABLED=true

# ---------------- 后端 CORS 白名单 (逗号分隔, Spring: app.cors.allowed-origins) ----------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 向量数据库 ----------------
CHROMA_PERSIST_DIR=./data/chroma

# ---------------- 文件上传 ----------------
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20
