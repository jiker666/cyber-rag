# =====================================================================
# 基于 RAG 的网络安全知识智能问答系统 - 环境变量示例
# 复制为 .env 后按需修改; 严禁将真实 API Key 提交到代码仓库
# =====================================================================

# ---------------- MySQL ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cyber_rag
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ---------------- Spring Boot ----------------
SERVER_PORT=8080
# JWT 密钥: 至少 32 字符随机字符串, 生产环境必须更换
JWT_SECRET=cyber-rag-jwt-secret-please-change-to-random-32chars
JWT_EXPIRE_HOURS=24

# ---------------- Python RAG 服务 ----------------
RAG_SERVICE_PORT=8000
# RAG 服务内部通信令牌(Java 后端与 Python 服务之间), 两端需一致
RAG_INTERNAL_TOKEN=cyber-rag-internal-token-change-me

# ---------------- LLM (OpenAI Compatible) ----------------
# 支持 GLM / Qwen / DeepSeek / OpenAI 等兼容接口
# LLM_PROVIDER: openai(默认, /chat/completions) | anthropic(Anthropic 兼容 /v1/messages)
# 智谱 BigModel 示例(Anthropic 兼容通道):
#   LLM_PROVIDER=anthropic
#   LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   LLM_MODEL=glm-5.3-flash
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# ---------------- Embedding ----------------
# local: 本地 sentence-transformers 模型(默认); openai: OpenAI 兼容 Embedding API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# 轻量替代方案(显存/内存不足时, 论文实验即用此模型, 512 维): BAAI/bge-small-zh-v1.5
# openai 模式下的配置(EMBEDDING_DIMENSION 需与所选模型一致, 如 text-embedding-3-small=1536)
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_DIMENSION=1024

# ---------------- Reranker (可选) ----------------
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------------- 检索策略 (rag-service 默认, 可被 rag_config/请求参数覆盖) ----------------
# vector = 纯向量 | hybrid = 向量+BM25 RRF 融合
RAG_RETRIEVAL_STRATEGY=vector

# ---------------- 后端 CORS 白名单 (逗号分隔, Spring: app.cors.allowed-origins) ----------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 向量数据库 ----------------
CHROMA_PERSIST_DIR=./data/chroma

# ---------------- 文件上传 ----------------
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20
